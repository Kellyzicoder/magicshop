{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MagicShop",
  "version": "0.6.0",
  "identifier": "com.kellyzicoder.magicshop",
  "build": {
    "frontendDist": "../dist-app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MagicShop",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
